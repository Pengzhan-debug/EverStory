# LLM_MODE=stub -> deterministic offline mode (no API key needed, great for tests/demo)
# LLM_MODE=api   -> call an OpenAI-compatible endpoint
LLM_MODE=stub

# ============================================================
# 强模型：意图解析 + 一致性裁判
# ============================================================
LLM_STRONG_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_STRONG_API_KEY=
LLM_STRONG_MODEL=qwen-plus

# ============================================================
# 弱模型：叙述生成（可以和强模型用不同厂商）
# DeepSeek 示例：LLM_CHEAP_BASE_URL=https://api.deepseek.com/v1
# ============================================================
LLM_CHEAP_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_CHEAP_API_KEY=
LLM_CHEAP_MODEL=qwen-turbo
