# LLM_MODE=stub -> deterministic offline mode (no API key needed, great for tests/demo)
# LLM_MODE=api   -> call any OpenAI-compatible endpoint (Qwen, DeepSeek, ...)
LLM_MODE=stub

# DashScope (Qwen) OpenAI-compatible endpoint
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=

# Strong model: intent parsing + consistency judging
LLM_MODEL_STRONG=qwen-plus
# Cheap model: narration
LLM_MODEL_CHEAP=qwen-turbo
