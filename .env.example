# LLM_MODE=stub -> deterministic offline mode (no API key needed, great for tests/demo)
# LLM_MODE=api   -> call an OpenAI-compatible endpoint
LLM_MODE=stub

# ============================================================
# 服务商 1：通义千问（DashScope，默认）
# ============================================================
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
# 强模型：意图解析 + 一致性裁判
LLM_MODEL_STRONG=qwen-plus
# 便宜模型：叙述生成
LLM_MODEL_CHEAP=qwen-turbo

# ============================================================
# 服务商 2：DeepSeek（二选一：改用下面这套，并把上面注释掉）
# ============================================================
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=
# LLM_MODEL_STRONG=deepseek-chat
# LLM_MODEL_CHEAP=deepseek-chat

# ============================================================
# 多厂商评测（可选）：把要对比的厂商名填进来，并逐个配密钥
# ============================================================
# LLM_PROVIDERS=qwen,deepseek
# LLM_PROVIDER_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_PROVIDER_QWEN_API_KEY=
# LLM_PROVIDER_QWEN_STRONG_MODEL=qwen-plus
# LLM_PROVIDER_QWEN_CHEAP_MODEL=qwen-turbo
# LLM_PROVIDER_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# LLM_PROVIDER_DEEPSEEK_API_KEY=
# LLM_PROVIDER_DEEPSEEK_STRONG_MODEL=deepseek-chat
# LLM_PROVIDER_DEEPSEEK_CHEAP_MODEL=deepseek-chat

# ============================================================
# 角色级混合路由（可选）：强模型和弱模型可以用不同厂商
# 例：意图解析/一致性裁判用千问，叙述生成用 DeepSeek
# 名字必须对应上面 LLM_PROVIDERS 里的厂商名
# ============================================================
# LLM_ROLE_STRONG=qwen
# LLM_ROLE_CHEAP=deepseek
