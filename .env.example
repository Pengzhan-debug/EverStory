# LLM_MODE=stub -> deterministic offline mode (no API key needed, great for tests/demo)
# LLM_MODE=api   -> call an OpenAI-compatible endpoint
LLM_MODE=stub

# Optional production infrastructure. Leave both blank for the original local
# file/in-memory mode. PostgreSQL owns runtime/save/usage data; Redis supplies
# session TTL, mutation rate limits, and cross-process player locks.
DATABASE_URL=
DATABASE_AUTO_CREATE=true
REDIS_URL=
SESSION_TTL_SECONDS=2592000
RATE_LIMIT_REQUESTS=0
RATE_LIMIT_WINDOW_SECONDS=60
INFRA_STRICT=false
# Force Secure cookies behind a proxy that does not preserve the HTTPS scheme.
COOKIE_SECURE=false
CSRF_ENFORCE=true

# Account login. Development mode does not send email and may reveal the code
# in the local account panel. Use SMTP and a stable random secret in production.
AUTH_CHALLENGE_SECRET=replace-with-at-least-32-random-characters
AUTH_EMAIL_MODE=development
AUTH_DEV_EXPOSE_CODE=true
AUTH_REQUEST_LIMIT=5
AUTH_REQUEST_WINDOW_SECONDS=600
AUTH_SMTP_HOST=
AUTH_SMTP_PORT=587
AUTH_SMTP_USERNAME=
AUTH_SMTP_PASSWORD=
AUTH_SMTP_FROM=
AUTH_SMTP_TLS=true
AUTH_SMTP_SSL=false

# Hosted/default API allowance per anonymous browser session. Set 0 for no
# limit in a private deployment. Player-provided API connections do not count.
PLATFORM_SESSION_TOKEN_LIMIT=50000

# Optional Volcengine Ark multi-model catalog. All models share one Base URL,
# while each model keeps its own credential. Never commit real key values.
ARK_ENABLE_CATALOG=false
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
ARK_KIMI_K27_CODE_API_KEY=
ARK_DEEPSEEK_V4_PRO_API_KEY=
ARK_DEEPSEEK_V4_FLASH_API_KEY=
ARK_GLM_53_API_KEY=
ARK_MINIMAX_M3_API_KEY=
ARK_DOUBAO_SEED_20_LITE_API_KEY=
ARK_DOUBAO_SEED_21_TURBO_API_KEY=

# ============================================================
# 强模型：意图解析 + 一致性裁判
# ============================================================
LLM_STRONG_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_STRONG_API_KEY=
LLM_STRONG_MODEL=qwen-plus
# Optional USD prices per 1M tokens for dashboard cost estimates.
LLM_STRONG_INPUT_COST_PER_MILLION=0
LLM_STRONG_OUTPUT_COST_PER_MILLION=0

# ============================================================
# 弱模型：叙述生成（可以和强模型用不同厂商）
# DeepSeek 示例：LLM_CHEAP_BASE_URL=https://api.deepseek.com/v1
# ============================================================
LLM_CHEAP_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_CHEAP_API_KEY=
LLM_CHEAP_MODEL=qwen-turbo
LLM_CHEAP_INPUT_COST_PER_MILLION=0
LLM_CHEAP_OUTPUT_COST_PER_MILLION=0
